FROM docker.io/library/node:22-trixie

ARG FLUTTER_VERSION=3.38.10
ARG ANDROID_CMDLINE_TOOLS=13114758
ARG ANDROID_PLATFORM=android-36
ARG ANDROID_BUILD_TOOLS=35.0.0
ARG ANDROID_NDK=28.2.13676358
ARG ANDROID_CMAKE=3.22.1
ARG PROCESS_COMPOSE_VERSION=v1.122.0
ARG FIREBASE_TOOLS_VERSION=15.32.1

RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "60";\n' > /etc/apt/apt.conf.d/80retries \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      openjdk-21-jdk-headless chromium chromium-driver just \
      git curl ca-certificates unzip xz-utils zip \
      libsqlite3-dev sqlite3 \
      python3 procps lsof iproute2 \
 && rm -rf /var/lib/apt/lists/*

RUN printf '#!/bin/sh\nexec /usr/bin/chromium --no-sandbox --disable-dev-shm-usage "$@"\n' \
      > /usr/local/bin/chromium-container \
 && chmod +x /usr/local/bin/chromium-container

RUN curl -fsSL "https://github.com/F1bonacc1/process-compose/releases/download/${PROCESS_COMPOSE_VERSION}/process-compose_linux_arm64.tar.gz" \
      | tar -xz -C /usr/local/bin process-compose

ENV NO_UPDATE_NOTIFIER=1 \
    JAVA_HOME=/usr/lib/jvm/java-21-openjdk-arm64
RUN npm install -g "firebase-tools@${FIREBASE_TOOLS_VERSION}" \
 && firebase setup:emulators:firestore \
 && firebase setup:emulators:ui \
 && npm cache clean --force

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH=$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH
RUN mkdir -p $ANDROID_HOME/cmdline-tools \
 && curl -fsSL -o /tmp/cmdline-tools.zip \
      "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS}_latest.zip" \
 && unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline-tools \
 && mv /tmp/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest \
 && rm -rf /tmp/cmdline-tools /tmp/cmdline-tools.zip \
 && yes | sdkmanager --licenses >/dev/null \
 && sdkmanager --install \
      "platform-tools" \
      "platforms;${ANDROID_PLATFORM}" \
      "build-tools;${ANDROID_BUILD_TOOLS}"

ENV FLUTTER_ROOT=/opt/flutter \
    CHROME_EXECUTABLE=/usr/local/bin/chromium-container \
    FLUTTER_SUPPRESS_ANALYTICS=true \
    TAR_OPTIONS=--no-same-owner
ENV PATH=$FLUTTER_ROOT/bin:$PATH
RUN git config --system --add safe.directory '*' \
 && git clone --depth 1 --branch "${FLUTTER_VERSION}" https://github.com/flutter/flutter.git $FLUTTER_ROOT \
 && flutter config --no-analytics --no-cli-animations \
 && dart --disable-analytics \
 && flutter precache --android --web --no-ios --no-linux --no-macos --no-windows --no-fuchsia \
 && flutter --version

ENV PUB_CACHE=/cache/pub \
    GRADLE_USER_HOME=/cache/gradle \
    ANDROID_USER_HOME=/cache/android

RUN sdkmanager --install "ndk;${ANDROID_NDK}" "cmake;${ANDROID_CMAKE}"

RUN dpkg --add-architecture amd64 \
 && apt-get update \
 && apt-get install -y --no-install-recommends libc6:amd64 libstdc++6:amd64 zlib1g:amd64 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
